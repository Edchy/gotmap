# Dependencies
node_modules/

# Build output — `npm run build` regenerates it
dist/

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# Local env
.env
.env.local
.env.*.local

# Tracked deliberately, listed here so the choice is visible:
#
#   public/data/    — generated by `npm run data`, but fetched from a
#                     third-party GitHub repo at build time. If upstream moves
#                     or disappears, an untracked copy means the map cannot be
#                     rebuilt. 532K is cheap insurance.
#   public/glyphs/  — SDF glyphs built from the fonts in assets/. Self-hosted
#                     on purpose (no glyph server, no CDN), so they belong to
#                     the repo, not to a build step someone has to know about.
#   assets/fonts/   — Inter, with its licence. Same reason.
