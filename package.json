{
  "name": "known-world-atlas",
  "version": "0.1.0",
  "description": "An interactive atlas of Westeros.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-style.mjs && node scripts/check-region-contrast.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "data": "node scripts/prepare-data.mjs",
    "wiki-links": "node scripts/check-wiki-links.mjs",
    "glyphs": "node scripts/build-glyphs.mjs",
    "check": "node scripts/validate-style.mjs && node scripts/check-region-contrast.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/geojson": "^7946.0.16",
    "fontnik": "^0.7.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "maplibre-gl": "^6.4.1"
  },
  "private": true
}
